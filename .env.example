# =============================================================
# Variables de ambiente para DESARROLLO LOCAL.
# Copia este archivo como .env y ajusta los valores.
# NUNCA uses credenciales reales ni de producción aquí.
# =============================================================

POSTGRES_USER=declaranet
POSTGRES_PASSWORD=declaranet_dev
POSTGRES_DB=declaranet
POSTGRES_PORT=5432

# Cadena de conexión equivalente para herramientas (psql, pg_dump, migraciones)
DATABASE_URL=postgres://declaranet:declaranet_dev@localhost:5432/declaranet
